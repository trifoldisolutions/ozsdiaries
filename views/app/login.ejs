<%- include('../partials/header', { title }) %>

<main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4">
  <h1 class="text-2xl font-semibold">Log In / Sign Up</h1>
  <p class="mt-2 text-slate-600">Placeholder combined auth page — wire up real auth once requirements are defined.</p>

  <form class="mt-6 flex flex-col gap-3" method="POST" action="/app/login">
    <input class="rounded border border-slate-300 px-3 py-2" type="email" name="email" placeholder="Email" />
    <input class="rounded border border-slate-300 px-3 py-2" type="password" name="password" placeholder="Password" />
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" type="submit">Continue</button>
  </form>
</main>

<%- include('../partials/footer') %>

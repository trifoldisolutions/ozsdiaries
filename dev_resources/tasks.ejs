<%- include('partials/header', { title }) %>

<main class="mx-auto max-w-3xl px-4 py-12">
  <h1 class="text-2xl font-semibold">Internal Task Board</h1>

  <% if (!mongoConfigured) { %>
    <p class="mt-3 rounded-lg bg-amber-100 px-4 py-3 text-amber-900">
      MONGO_URI is not set in .env — tasks won't persist until it's configured.
    </p>
  <% } %>

  <form class="mt-6 flex flex-col gap-3 rounded-lg border border-slate-200 p-4" method="POST" action="/dev-resources/tasks">
    <input class="rounded border border-slate-300 px-3 py-2" type="text" name="title" placeholder="Task title" required />
    <textarea class="rounded border border-slate-300 px-3 py-2" name="description" placeholder="Description"></textarea>
    <button class="self-start rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" type="submit">Add task</button>
  </form>

  <ul class="mt-8 flex flex-col gap-3">
    <% tasks.forEach(function(task) { %>
      <li class="rounded-lg border border-slate-200 p-4">
        <details>
          <summary class="cursor-pointer list-none">
            <span class="font-medium"><%= task.title %></span>
            <span class="ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs uppercase tracking-wide text-slate-600"><%= task.status %></span>
          </summary>

          <p class="mt-2 text-sm text-slate-600"><%= task.description %></p>

          <form class="mt-4 flex flex-col gap-2" method="POST" action="/dev-resources/tasks/<%= task._id %>/edit">
            <input class="rounded border border-slate-300 px-3 py-2" type="text" name="title" value="<%= task.title %>" required />
            <textarea class="rounded border border-slate-300 px-3 py-2" name="description"><%= task.description %></textarea>
            <select class="rounded border border-slate-300 px-3 py-2" name="status">
              <option value="todo" <%= task.status === 'todo' ? 'selected' : '' %>>Todo</option>
              <option value="in-progress" <%= task.status === 'in-progress' ? 'selected' : '' %>>In progress</option>
              <option value="done" <%= task.status === 'done' ? 'selected' : '' %>>Done</option>
            </select>
            <div class="flex gap-2">
              <button class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" type="submit">Save</button>
            </div>
          </form>

          <form class="mt-2" method="POST" action="/dev-resources/tasks/<%= task._id %>/delete">
            <button class="rounded-lg bg-red-600 px-4 py-2 text-white hover:bg-red-500" type="submit">Delete</button>
          </form>
        </details>
      </li>
    <% }) %>

    <% if (!tasks.length) { %>
      <li class="text-slate-500">No tasks yet.</li>
    <% } %>
  </ul>
</main>

<%- include('partials/footer') %>
